{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/vaultdbai/nandi-registry/registry-schema/pack.schema.json",
  "title": "Nandi registry pack",
  "description": "A curated bundle of agents in a Nandi registry (packs/<id>.json). Authoritative for the in-app marketplace and the static website.",
  "type": "object",
  "required": [
    "id",
    "name",
    "description",
    "publisher",
    "repo",
    "latest_version",
    "tags",
    "min_nandi_version",
    "capabilities",
    "icon_url",
    "readme_url",
    "agents"
  ],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
    "name": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "publisher": {
      "type": "string",
      "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9-]{0,38})$",
      "description": "GitHub handle of the publisher"
    },
    "repo": {
      "type": "string",
      "description": "Where the pack's source lives, e.g. github.com/user/repo"
    },
    "latest_version": { "$ref": "agent.schema.json#/$defs/semver" },
    "tags": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "minItems": 1
    },
    "min_nandi_version": { "$ref": "agent.schema.json#/$defs/semver" },
    "capabilities": {
      "$ref": "agent.schema.json#/$defs/capabilities",
      "description": "Everything the pack's agents together request"
    },
    "icon_url": { "type": "string", "format": "uri" },
    "readme_url": { "type": "string", "format": "uri" },
    "agents": {
      "type": "array",
      "description": "The agents in this pack, each described so the pack file stands on its own",
      "items": {
        "type": "object",
        "required": ["id", "name", "description"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$",
            "description": "An agent.schema.json id"
          },
          "name": { "type": "string", "minLength": 1 },
          "description": { "type": "string" }
        }
      },
      "minItems": 1,
      "uniqueItems": true
    },

    "install_count": {
      "type": "integer",
      "minimum": 0,
      "description": "Reserved"
    },
    "rating": {
      "type": "number",
      "minimum": 0,
      "maximum": 5,
      "description": "Reserved"
    },
    "verified": { "type": "boolean", "description": "Reserved" },
    "signature": { "type": "string", "description": "Reserved" },
    "deprecated": { "type": "boolean", "description": "Reserved" },
    "license": {
      "type": "string",
      "description": "Reserved: SPDX license identifier"
    }
  }
}
